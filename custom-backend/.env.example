# Django backend environment variables
# Copy this file to .env and fill in values for production.
# For development, SQLite works fine without any of this.

# Django secret key (change in production!)
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me

# Set to true in production
DJANGO_DEBUG=True

# Comma-separated list of allowed hostnames
DJANGO_ALLOWED_HOSTS=*

# PostgreSQL connection (optional — leave empty to use SQLite)
# DATABASE_URL=postgres://user:password@localhost:5432/osdag_db

# Token lifetimes (minutes / days)
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Rate limiting
MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# CORS (set to false in production)
CORS_ALLOW_ALL_ORIGINS=True
