# Copy this file to .env and adjust as needed. The project runs out of the box
# with the defaults below (SQLite + a dev secret key).

# Leave True for local development; must be False in production.
DJANGO_DEBUG=True

# Generate a strong random key for production: python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=dev-insecure-secret-key-change-me

DJANGO_ALLOWED_HOSTS=*


CORS_ALLOW_ALL_ORIGINS=True

# ---------------------------------------------------------------------------
# Database. Leave DATABASE_URL unset to use SQLite (zero setup, fine for the
# demo). For PostgreSQL (the production database for this project), provide:
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME
# ---------------------------------------------------------------------------
# DATABASE_URL=

ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

MAX_FAILED_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
